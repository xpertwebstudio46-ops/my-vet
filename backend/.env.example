# Railway injects PORT and DATABASE_URL. Set the remaining values in Railway Variables.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/myvet
DATABASE_URL_TEST=
TRUST_PROXY=1
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_ISSUER=my-vet-api
JWT_AUDIENCE=my-vet-web

REFRESH_COOKIE_NAME=myvet_refresh
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

MAIL_FROM=no-reply@example.com
PASSWORD_RESET_URL=http://localhost:3000/reset-password

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

R2_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_CDN_URL=
