# Used by Next.js server components. On Railway, set this to the public backend URL.
API_URL=http://localhost:5000

# Used by browser-side login, forms, and Socket.IO. This value is embedded at build time.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public R2 custom domain or temporary r2.dev URL. Required for next/image remote images.
NEXT_PUBLIC_R2_PUBLIC_URL=
